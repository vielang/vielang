# ---- Supabase (Database + Auth) ----
# Server-side (service role — full access, NEVER expose to client)
SUPABASE_URL="https://xxx.supabase.co"
SUPABASE_SERVICE_ROLE_KEY=""

# Client-side (anon public key — safe to expose)
NEXT_PUBLIC_SUPABASE_URL="https://xxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

# ---- Site ----
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ---- LiveKit (self-hosted via docker/) ----
# Keys MUST match the `keys:` section of docker/livekit.yaml. Dev defaults
# below; rotate for prod. Boot: `docker compose -f docker/docker-compose.dev.yml up -d`.
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="devsecret_at_least_32_chars_long_xxxxxxxx"
NEXT_PUBLIC_LIVEKIT_WS_URL="ws://localhost:7880"

# ---- Observability ----
# pino log level. One of: fatal, error, warn, info, debug, trace.
# Defaults to 'info' in prod, 'debug' in dev.
LOG_LEVEL=""
# Sentry DSN (leave empty to disable). Same value works for client + server;
# NEXT_PUBLIC_ prefix is required for the browser SDK to see it.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# Auth token for source-map upload during Vercel build (set in Vercel only).
SENTRY_AUTH_TOKEN=""

# ---- Rate limiting (Upstash Redis) ----
# Leave both empty for dev — the limiter falls back to an in-memory sliding
# window. Set both in Vercel/prod to enable durable, cross-instance limits.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Set to "true" to disable ALL limiters (CI + E2E only). Never in prod.
RATE_LIMIT_DISABLED=""

# ---- Email (Resend) ----
# Leave RESEND_API_KEY empty in dev — sendEmail() becomes a no-op and every
# call still writes a notification_log row so the plumbing is testable
# without shipping real mail.
RESEND_API_KEY=""
EMAIL_FROM="VieLang <no-reply@vielang.com>"
EMAIL_REPLY_TO=""

# ---- Cron (Vercel Cron) ----
# Vercel sends `Authorization: Bearer $CRON_SECRET` when it fires
# /api/cron/*. Any value works — just keep it long + secret. Missing =
# every cron endpoint returns 401.
CRON_SECRET=""
