# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env*.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# nội dung: build-content.ts sinh ra từ content/notes/<bookId>/*.md,
# content/quiz/<bookId>/*.json, content/translate/<bookId>/*.json,
# content/grammar/<bookId>/*.json và content/answers/<bookId>/*.json, luôn
# chạy lại qua predev/prebuild — không commit các file .json gộp này
/content/notes/*.json
/content/quiz/*.json
/content/translate/*.json
/content/grammar/*.json
/content/answers/*.json

# font Excalidraw: copy-excalidraw-fonts.ts chép từ node_modules, luôn chạy
# lại qua predev/prebuild — không commit ~14MB nhị phân trùng với dependency
/public/excalidraw/

# ảnh trang tải về để soạn bản dịch — chỉ dùng lúc làm nội dung
/scratch/


# đề thi: tài nguyên sinh ra từ PDF/MP3 gốc, đưa lên R2 bằng prepare-exams — không commit
/public/img/exams/
/content/it/courses.json
/content/cam-nang/guide.json

# Công cụ kiểm tra cú pháp C# của bài học IT (chạy bằng .NET SDK)
scripts/csharp-check/bin/
scripts/csharp-check/obj/
scripts/csharp-compile/bin/
scripts/csharp-compile/obj/
