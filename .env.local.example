# Sao chép file này thành .env.local rồi điền giá trị thật.
# .env.local đã nằm trong .gitignore — không bao giờ commit lên git.

# --- Chỉ dùng bởi scripts/prepare-images.ts (không lộ ra client) ---
# Cloudflare dashboard > R2 > Manage API tokens > Create API token
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=kiip-reader

# --- Dùng bởi cả app (client) lẫn script ---
# URL public của bucket, vd https://pub-xxxxxxxx.r2.dev
# hoặc custom domain đã map, vd https://cdn.example.com
NEXT_PUBLIC_IMAGE_BASE_URL=
